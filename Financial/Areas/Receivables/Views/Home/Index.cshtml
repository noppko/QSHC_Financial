@model ReceivableOverview
@inject Microsoft.Extensions.Options.IOptions<Financial.Services.Authorization.RoleOptions> RoleSettings
@{
    ViewData["Title"] = "ภาพรวมลูกหนี้สิทธิ";
    var th = System.Globalization.CultureInfo.GetCultureInfo("th-TH");
    var isAdmin = Financial.Services.Authorization.AppPolicies.IsAdmin(User, RoleSettings.Value);
    var syncDays = ViewData["SyncDays"] as int[] ?? [];
    var defaultDays = ViewData["DefaultSyncDays"] as int? ?? 90;
    var syncStatus = ViewData["SyncStatus"] as ReceivableSyncStatus;
}

<div class="space-y-5">
    <!-- ================= 4 สิทธิ์ ================= -->
    <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4" aria-label="ยอดคงค้างแยกสิทธิ์">
        @foreach (var card in Model.Schemes)
        {
            var active = card.Code == Model.SchemeCode;
            <a asp-action="Index" asp-route-scheme="@card.Code" aria-current="@(active ? "page" : null)" data-scheme-card="@card.Code"
               class="card card-body block transition hover:-translate-y-0.5 hover:shadow-md @(active ? "ring-2 ring-brand-500" : "")">
                <div class="flex items-center justify-between">
                    <span class="font-semibold text-stone-900">@card.Name</span>
                    <span class="text-xs text-stone-500">@card.Count.ToString("N0") รายการ</span>
                </div>
                <div class="mt-2 text-2xl font-semibold text-stone-900 tabular-nums">@card.Outstanding.ToString("N2")</div>
                <div class="text-xs text-stone-500">บาท คงค้าง · เกิน 90 วัน <span class="font-medium @(card.Over90 > 0 ? "text-amber-700" : "")">@card.Over90.ToString("N2")</span></div>
            </a>
        }
    </section>

    @foreach (var warning in Model.Warnings)
    {
        <div class="alert-info" role="status">@warning</div>
    }

    <!-- ================= ส่วนหัวสิทธิ์ที่เลือก ================= -->
    <section class="card card-body flex flex-wrap items-center justify-between gap-4">
        <div>
            <h2 class="text-lg font-semibold text-stone-900">@Model.SchemeName</h2>
            <p class="text-xs text-stone-500">
                คงค้าง @Model.Outstanding.ToString("N2") บาท จาก @Model.Count.ToString("N0") รายการ ·
                @(Model.LastSyncedAt is DateTime synced ? $"ดึงจาก HIS ล่าสุด {synced.ToString("d MMM yyyy HH:mm", th)} น." : "ยังไม่มีข้อมูล")
            </p>
        </div>
        <a asp-controller="Receivables" asp-action="Index" asp-route-scheme="@Model.SchemeCode" class="btn-primary">ดูรายการลูกหนี้</a>
    </section>

    <div class="grid gap-5 xl:grid-cols-2">
        <!-- อายุหนี้ -->
        <section class="card card-body">
            <h3 class="mb-3 font-semibold text-stone-900">อายุหนี้ <span class="text-xs font-normal text-stone-500">(นับจากวันออกบิล)</span></h3>
            <table class="data-table">
                <thead><tr><th>ช่วง</th><th class="text-right">รายการ</th><th class="text-right">คงค้าง (บาท)</th><th class="text-right">ร้อยละ</th><th></th></tr></thead>
                <tbody>
                    @for (var i = 0; i < Model.Aging.Count; i++)
                    {
                        var a = Model.Aging[i];
                        var range = AgingRanges.ALL[i];
                        <tr>
                            <td>@a.Label</td>
                            <td class="num">@a.Count.ToString("N0")</td>
                            <td class="num">@a.Amount.ToString("N2")</td>
                            <td class="num">@a.Percent.ToString("N2")</td>
                            <td class="text-right"><a asp-controller="Receivables" asp-action="Index" asp-route-scheme="@Model.SchemeCode" asp-route-aging="@range.Code" class="text-xs text-brand-600 hover:underline">ดูรายการ</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <!-- OPD/IPD (+ เขต สำหรับ สปสช.) และสถานะ -->
        <section class="card card-body space-y-4">
            @foreach (var (title, rows) in new[] { ("ประเภทผู้ป่วย", Model.ByPatientType), ("เขต", Model.ByZone), ("สถานะ", Model.ByStatus) }.Where(x => x.Item2.Count > 0))
            {
                <div>
                    <h3 class="mb-2 font-semibold text-stone-900">@title</h3>
                    <ul class="space-y-2">
                        @foreach (var r in rows)
                        {
                            <li>
                                <div class="flex justify-between text-sm"><span>@r.Label <span class="text-xs text-stone-500">(@r.Count.ToString("N0"))</span></span><span class="tabular-nums">@r.Amount.ToString("N2")</span></div>
                                <div class="mt-1 h-2 rounded-full bg-sand-100"><div class="h-2 rounded-full bg-brand-500" style="width:@(Math.Clamp(r.Percent, 0, 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div></div>
                            </li>
                        }
                    </ul>
                </div>
            }
        </section>
    </div>

    <!-- ผู้จ่าย -->
    <section class="card card-body">
        <h3 class="mb-3 font-semibold text-stone-900">ผู้จ่ายที่คงค้างสูงสุด</h3>
        <div class="table-wrap">
            <table class="data-table">
                <thead><tr><th>ผู้จ่าย</th><th class="text-right">รายการ</th><th class="text-right">คงค้าง (บาท)</th><th class="text-right">ร้อยละ</th></tr></thead>
                <tbody>
                    @if (Model.TopPayors.Count == 0)
                    {
                        <tr><td colspan="4" class="py-8 text-center text-stone-500">ไม่มีข้อมูล</td></tr>
                    }
                    @foreach (var p in Model.TopPayors)
                    {
                        <tr>
                            <td class="whitespace-normal"><a asp-controller="Receivables" asp-action="Index" asp-route-scheme="@Model.SchemeCode" asp-route-payor="@p.Label" class="hover:text-brand-600 hover:underline">@p.Label</a></td>
                            <td class="num">@p.Count.ToString("N0")</td>
                            <td class="num">@p.Amount.ToString("N2")</td>
                            <td class="num">@p.Percent.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    @if (isAdmin)
    {
        <!-- ================= ดึงลูกหนี้จาก HIS (Admin) ================= -->
        <section class="card card-body" id="arSync" data-status-url="@Url.Action("SyncStatus")" data-sync-url="@Url.Action("Sync")" data-active="@((syncStatus?.IsActive == true) ? "true" : "false")">
            <h3 class="mb-1 font-semibold text-stone-900">ดึงลูกหนี้จาก HIS</h3>
            <p class="mb-3 text-xs text-stone-500">อ่านบิลเครดิตของ 4 สิทธิ์จาก HIS (อ่านอย่างเดียว) มาตั้งหนี้ที่ QSHC_Financial · ดึงอัตโนมัติทุกคืนย้อนหลัง @defaultDays วัน · ทำงานเบื้องหลัง ปิดหน้านี้ได้</p>
            <div class="flex flex-wrap items-end gap-3">
                <div>
                    <label for="syncDays" class="label">ย้อนหลัง (ตามวันออกบิล)</label>
                    <select id="syncDays" class="input w-40">
                        @foreach (var d in syncDays) { <option value="@d" selected="@(d == defaultDays)">@d วัน</option> }
                    </select>
                </div>
                <button type="button" id="syncButton" class="btn-primary">ดึงข้อมูล</button>
            </div>
            <div id="syncStatus" class="mt-3 text-sm text-stone-600" aria-live="polite">
                @if (syncStatus is not null)
                {
                    <span>@syncStatus.State · @syncStatus.Message</span>
                }
            </div>
        </section>
    }
</div>

@section Scripts {
    @if (isAdmin)
    {
        <script src="~/js/receivables-sync.js" asp-append-version="true"></script>
    }
}
