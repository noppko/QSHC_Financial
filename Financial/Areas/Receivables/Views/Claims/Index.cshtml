@model List<Financial.Models.Receivables.ArClaimBatch>
@{
    ViewData["Title"] = "ชุดเรียกเก็บ";
    var scheme = (string)ViewData["Scheme"]!;
    var schemeName = (string)ViewData["SchemeName"]!;
    string StatusName(string code) => ArClaimBatchStatusCodes.DEFAULT_NAMES.GetValueOrDefault(code, code);
    string Badge(string code) => code switch
    {
        ArClaimBatchStatusCodes.SENT => "bg-emerald-50 text-emerald-700",
        ArClaimBatchStatusCodes.CANCELLED => "bg-sand-100 text-stone-500",
        _ => "bg-amber-50 text-amber-700",
    };
}

<div class="space-y-5">
    <partial name="_SchemeTabs" model="@((scheme, "Claims", "Index"))" />
    @if (TempData["Message"] is string message)
    {
        <div class="alert-success" role="status">@message</div>
    }

    <section class="card card-body">
        <h2 class="mb-1 font-semibold text-stone-900">จัดชุดเรียกเก็บใหม่ — @schemeName</h2>
        <p class="mb-4 text-sm text-stone-500">เลือกลูกหนี้สถานะ "ตั้งหนี้" หรือ "อุทธรณ์/ส่งใหม่" ที่ยังมีคงค้าง และยังไม่อยู่ในชุดที่ยังไม่ส่ง (สูงสุด @ClaimBatchService.MAX_ITEMS.ToString("N0") รายการต่อชุด)</p>
        <form method="post" asp-action="Create" class="flex flex-wrap items-end gap-4" data-loading="กำลังจัดชุด...">
            <input type="hidden" name="scheme" value="@scheme" />
            <div>
                <label for="side" class="label">ประเภทผู้ป่วย</label>
                <select id="side" name="side" class="input w-36">
                    <option value="">ทั้งหมด</option>
                    <option value="O">OPD</option>
                    <option value="I">IPD</option>
                </select>
            </div>
            <div>
                <label for="billFrom" class="label">วันออกบิล ตั้งแต่</label>
                <input type="date" id="billFrom" name="billFrom" class="input w-40" />
            </div>
            <div>
                <label for="billTo" class="label">ถึง</label>
                <input type="date" id="billTo" name="billTo" class="input w-40" />
            </div>
            <div>
                <label for="payor" class="label">ผู้จ่าย (คำในชื่อ)</label>
                <input type="text" id="payor" name="payor" class="input w-48" maxlength="100" />
            </div>
            <div>
                <label for="note" class="label">หมายเหตุ</label>
                <input type="text" id="note" name="note" class="input w-56" maxlength="200" />
            </div>
            <button type="submit" class="btn-primary">จัดชุด</button>
        </form>
    </section>

    <section class="card card-body">
        <h2 class="mb-4 font-semibold text-stone-900">ชุดเรียกเก็บล่าสุด</h2>
        <div class="table-wrap">
            <table class="data-table">
                <thead><tr><th>เลขชุด</th><th>ประเภท</th><th>ช่วงวันออกบิล</th><th class="text-right">รายการ</th><th class="text-right">ยอดเรียกเก็บ (บาท)</th><th>วันที่ส่ง</th><th>เลขหนังสือ</th><th>สถานะ</th><th></th></tr></thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="9" class="py-10 text-center text-stone-500">ยังไม่มีชุดเรียกเก็บของสิทธิ์นี้</td></tr>
                    }
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td class="font-mono text-xs">@b.BatchNo</td>
                            <td>@(b.PatientTypeCode is null ? "ทั้งหมด" : PatientTypeCodes.Abbreviation(b.PatientTypeCode))</td>
                            <td>@(b.PeriodFrom?.ToString("dd/MM/yyyy") ?? "…") – @(b.PeriodTo?.ToString("dd/MM/yyyy") ?? "…")</td>
                            <td class="num">@b.ItemCount.ToString("N0")</td>
                            <td class="num">@b.TotalAmount.ToString("N2")</td>
                            <td>@b.SentDate?.ToString("dd/MM/yyyy")</td>
                            <td>@b.ReferenceDocNo</td>
                            <td><span class="badge @Badge(b.StatusCode)">@StatusName(b.StatusCode)</span></td>
                            <td class="text-right"><a asp-action="Detail" asp-route-id="@b.Id" class="text-sm text-brand-600 hover:underline">เปิด</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
