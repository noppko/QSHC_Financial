@{
    ViewData["Title"] = "ไม่มีสิทธิ์เข้าถึง";
}
<div class="mx-auto max-w-lg py-16 text-center">
    <div class="mx-auto mb-5 grid size-16 place-items-center rounded-2xl bg-amber-100 text-amber-600">
        <svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6l-8-3Z" /><path d="M12 9v4m0 3h.01" /></svg>
    </div>
    <h2 class="text-xl font-semibold text-stone-900">คุณไม่มีสิทธิ์เข้าถึงหน้านี้</h2>
    <p class="mt-2 text-sm text-stone-500">หากต้องการใช้งาน กรุณาติดต่อผู้ดูแลระบบเพื่อขอสิทธิ์เพิ่มเติม</p>
    <div class="mt-6 flex justify-center gap-3">
        <a asp-controller="Home" asp-action="Index" class="btn-primary">กลับหน้าหลัก</a>
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="btn-outline">เข้าสู่ระบบด้วยบัญชีอื่น</button>
        </form>
    </div>
</div>
