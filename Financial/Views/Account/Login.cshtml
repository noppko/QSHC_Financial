@model Financial.DTOs.Account.LoginRequest
@{
    ViewData["Title"] = "เข้าสู่ระบบ";
    Layout = null;
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>เข้าสู่ระบบ - QSHC Financial</title>
    <partial name="_Icons" />
    <link rel="preload" href="~/fonts/kanit/kanit-thai-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="grid min-h-screen place-items-center bg-linear-to-br from-sand-100 via-sand-50 to-brand-50 p-4">
    <main class="w-full max-w-md">
        <div class="card p-8 sm:p-10">
            <div class="mb-8 text-center">
                <div class="mx-auto mb-4 grid size-16 place-items-center rounded-2xl bg-linear-to-br from-brand-500 to-brand-400 shadow-lg shadow-brand-500/25">
                    <img src="~/images/qshclogo.png" alt="QSHC" class="size-11 object-contain" />
                </div>
                <h1 class="text-2xl font-semibold text-stone-900">QSHC Financial</h1>
                <p class="mt-1 text-sm text-stone-500">เข้าสู่ระบบด้วยบัญชีผู้ใช้ของโรงพยาบาล</p>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert-error mb-5 [&_ul]:list-none" role="alert"></div>

            <form asp-action="Login" method="post" id="loginForm" class="space-y-5" novalidate>
                <input asp-for="ReturnUrl" type="hidden" />

                <div>
                    <label asp-for="Username" class="label">ชื่อผู้ใช้</label>
                    <input asp-for="Username" class="input" autocomplete="username" autocapitalize="none" spellcheck="false" autofocus />
                    <span asp-validation-for="Username"></span>
                </div>

                <div>
                    <label asp-for="Password" class="label">รหัสผ่าน</label>
                    <div class="relative">
                        <input asp-for="Password" class="input pr-11" autocomplete="current-password" />
                        <button type="button" id="togglePassword" class="absolute inset-y-0 right-0 grid w-11 place-items-center text-stone-400 hover:text-stone-600" aria-label="แสดงรหัสผ่าน" aria-pressed="false">
                            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password"></span>
                    <p id="capsWarning" class="mt-1 hidden text-xs text-amber-600">Caps Lock เปิดอยู่</p>
                </div>

                <label class="flex items-center gap-2 text-sm text-stone-600">
                    <input asp-for="RememberMe" class="size-4 rounded accent-brand-500" />
                    จดจำการเข้าสู่ระบบ (8 ชั่วโมง)
                </label>

                <button type="submit" class="btn-primary w-full py-3 text-base">เข้าสู่ระบบ</button>
            </form>
        </div>

        <p class="mt-6 text-center text-xs text-stone-500">
            &copy; @DateTime.Now.Year ศูนย์หัวใจสิริกิติ์ภาคตะวันออกเฉียงเหนือ ·
            <a href="http://10.67.67.169/" class="text-brand-600 hover:underline" target="_blank" rel="noopener">www.sirikit.go.th</a>
        </p>
    </main>

    <script>
        (function () {
            const form = document.getElementById("loginForm");
            const password = document.getElementById("Password");
            const toggle = document.getElementById("togglePassword");
            const caps = document.getElementById("capsWarning");

            toggle.addEventListener("click", () => {
                const show = password.type === "password";
                password.type = show ? "text" : "password";
                toggle.setAttribute("aria-pressed", String(show));
                toggle.setAttribute("aria-label", show ? "ซ่อนรหัสผ่าน" : "แสดงรหัสผ่าน");
            });

            password.addEventListener("keyup", e => caps.classList.toggle("hidden", !e.getModifierState?.("CapsLock")));

            form.addEventListener("submit", e => {
                const user = document.getElementById("Username");
                if (!user.value.trim() || !password.value) {
                    e.preventDefault();
                    (user.value.trim() ? password : user).focus();
                    return;
                }
                const btn = form.querySelector('button[type="submit"]');
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner"></span><span>กำลังตรวจสอบ...</span>';
            });
        })();
    </script>
</body>
</html>
