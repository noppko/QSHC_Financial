@using Financial.Models.Dashboard
@using System.Text.Json
@model FinanceDashboard
@{
    ViewData["Title"] = "Dashboard การเงิน";
    var pendingO = Model.PendingPayments.Where(p => p.Type == "O").ToList();
    var pendingI = Model.PendingPayments.Where(p => p.Type == "I").ToList();
    var monthChange = Model.RevenuePreviousMonthToDate.Total == 0 ? 0
        : (Model.RevenueMonth.Total - Model.RevenuePreviousMonthToDate.Total) / Model.RevenuePreviousMonthToDate.Total * 100;
    var initialJson = JsonSerializer.Serialize(Model);
    var showIdentity = ViewData["ShowPatientIdentity"] is true;
}

@section Head {
    @* "!" ปิด tag helper ของ .NET (ถ้าไม่ปิด มันจะลบ type="importmap" ทิ้ง ทำให้ import "three" ไม่ได้และ 3D ไม่แสดง) *@
    <!script type="importmap">
        { "imports": { "three": "@Url.Content("~/lib/three/three.module.min.js")", "three/addons/": "@Url.Content("~/lib/three/addons/")" } }
    </!script>
}

<div class="space-y-5" id="dashboard" data-source="@Url.Action("DashboardData")" data-identity="@(showIdentity ? "true" : "false")">
    @if (Model.IsSample)
    {
        <div class="alert-info" role="status">
            <svg class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9" /><path d="M12 8h.01M11 12h1v4h1" /></svg>
            <span><strong>ข้อมูลตัวอย่าง</strong> — ตั้งค่า <code>Dashboard:Source = "His"</code> เพื่อใช้ข้อมูลจริงจาก HIS HealthObject ตัวเลขบนหน้านี้ใช้สำหรับทดสอบหน้าจอเท่านั้น</span>
        </div>
    }

    <div id="dashboardWarnings" class="alert-error @(Model.Warnings.Count == 0 ? "hidden" : "")" role="alert">
        <svg class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9" /><path d="M12 8v4m0 4h.01" /></svg>
        <span data-field="Warnings">@string.Join(" · ", Model.Warnings)</span>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-2 text-sm text-stone-500">
        <span>
            <span class="badge bg-sand-200 text-stone-600" data-field="DataSource">@Model.DataSource</span>
            ข้อมูล ณ <time data-field="GeneratedAt">@Model.GeneratedAt.ToString("d MMM yyyy HH:mm:ss", System.Globalization.CultureInfo.GetCultureInfo("th-TH"))</time> น. · อัปเดตอัตโนมัติทุก 60 วินาที
        </span>
        <button type="button" class="btn-outline py-1.5" id="refreshBtn">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 11a8 8 0 1 0-2.3 5.7M20 4v7h-7" /></svg>
            รีเฟรช
        </button>
    </div>

    <!-- ================= KPI ================= -->
    <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4" aria-label="ตัวชี้วัดหลัก">
        <div class="card card-body">
            <div class="text-sm text-stone-500">รายได้วันนี้</div>
            <div class="mt-1 text-2xl font-semibold text-stone-900 tabular-nums" data-field="RevenueToday.Total">฿@Model.RevenueToday.Total.ToString("N0")</div>
            <div class="mt-2 flex gap-3 text-xs text-stone-500">
                <span><span class="inline-block size-2 rounded-full bg-brand-500"></span> OPD <b class="tabular-nums" data-field="RevenueToday.Opd">฿@Model.RevenueToday.Opd.ToString("N0")</b></span>
                <span><span class="inline-block size-2 rounded-full bg-stone-800"></span> IPD <b class="tabular-nums" data-field="RevenueToday.Ipd">฿@Model.RevenueToday.Ipd.ToString("N0")</b></span>
            </div>
        </div>
        <div class="card card-body">
            <div class="text-sm text-stone-500">รายได้เดือนนี้</div>
            <div class="mt-1 text-2xl font-semibold text-stone-900 tabular-nums" data-field="RevenueMonth.Total">฿@Model.RevenueMonth.Total.ToString("N0")</div>
            <div class="mt-2 text-xs text-stone-500">
                <span class="badge @(monthChange >= 0 ? "bg-emerald-50 text-emerald-700" : "bg-red-50 text-red-700")" data-field="MonthChange">@(monthChange >= 0 ? "▲" : "▼") @Math.Abs(monthChange).ToString("N1")%</span>
                เทียบช่วงเดียวกันของเดือนก่อน
            </div>
        </div>
        <div class="card card-body">
            <div class="text-sm text-stone-500" title="บิลเครดิต (CREDBL) ที่ออกเดือนนี้ — ยอดรับชำระจากผู้จ่ายสิทธิอยู่ในระบบบัญชี ไม่อยู่ใน HIS">ตั้งลูกหนี้สิทธิเดือนนี้</div>
            <div class="mt-1 text-2xl font-semibold text-stone-900 tabular-nums" data-field="CreditBilledMonth.Total">฿@Model.CreditBilledMonth.Total.ToString("N0")</div>
            <div class="mt-2 text-xs text-stone-500">
                บิลเครดิต <b data-field="CreditBillsMonth">@Model.CreditBillsMonth.ToString("N0")</b> ใบ ·
                เงินสด <b data-field="CashBilledMonth.Total">฿@Model.CashBilledMonth.Total.ToString("N0")</b>
            </div>
        </div>
        <div class="card card-body border-brand-200 bg-brand-50/40">
            <div class="text-sm text-brand-700">ผู้ป่วยรอชำระเงิน</div>
            <div class="mt-1 text-2xl font-semibold text-stone-900 tabular-nums" data-field="PendingTotal">฿@Model.PendingPayments.Sum(p => p.Amount).ToString("N0")</div>
            <div class="mt-2 flex gap-3 text-xs text-stone-600">
                <span>OPD <b data-field="PendingOCount">@pendingO.Count</b> ราย</span>
                <span>IPD <b data-field="PendingICount">@pendingI.Count</b> ราย</span>
            </div>
        </div>
    </section>

    <!-- ================= 3D Digital Twin ================= -->
    <section class="card overflow-hidden" aria-labelledby="twinTitle">
        <div class="flex flex-wrap items-center gap-3 border-b border-sand-200 px-5 py-3">
            <div>
                <h2 id="twinTitle" class="font-semibold text-stone-900">3D Digital Twin — เงินที่รอชำระ แยก OPD / IPD</h2>
                <p class="text-xs text-stone-500">แต่ละคนคือผู้ป่วย 1 ราย · สีเสื้อ = ระยะเวลารอ · เหรียญเหนือศีรษะ = ค่าใช้จ่ายรวม (ยิ่งสูงยิ่งมาก) · ยืนที่เคาน์เตอร์ = การเงินรับเรื่องแล้ว · OPD นับจากออกจากห้องตรวจ (CHKOUT) ถึงปิดบัญชี (FINDIS) · IPD นับจาก Medical Discharge</p>
            </div>
            <div class="ml-auto flex flex-wrap items-center gap-2" role="group" aria-label="ตัวกรอง 3D">
                <button type="button" class="btn-outline px-3 py-1.5 aria-pressed:border-brand-500 aria-pressed:bg-brand-50 aria-pressed:text-brand-700" data-twin-filter="all" aria-pressed="true">ทั้งหมด</button>
                <button type="button" class="btn-outline px-3 py-1.5 aria-pressed:border-brand-500 aria-pressed:bg-brand-50 aria-pressed:text-brand-700" data-twin-filter="O" aria-pressed="false">OPD</button>
                <button type="button" class="btn-outline px-3 py-1.5 aria-pressed:border-brand-500 aria-pressed:bg-brand-50 aria-pressed:text-brand-700" data-twin-filter="I" aria-pressed="false">IPD</button>
                <button type="button" class="btn-ghost px-3 py-1.5" id="twinRotate" aria-pressed="false">หมุนอัตโนมัติ</button>
            </div>
        </div>
        <div class="grid lg:grid-cols-[1fr_280px]">
            <div class="relative h-135 bg-linear-to-b from-sand-50 to-sand-200" id="twinStage">
                <canvas id="twinCanvas" class="absolute inset-0 size-full" aria-label="แบบจำลอง 3 มิติของยอดเงินผู้ป่วยรอชำระ"></canvas>
                <div id="twinTooltip" class="pointer-events-none absolute hidden min-w-48 rounded-xl border border-sand-200 bg-white/95 px-3 py-2 text-xs shadow-lg"></div>
                <div class="absolute right-3 bottom-3 flex flex-col gap-1.5" role="group" aria-label="ควบคุมมุมมอง 3D">
                    <button type="button" id="twinZoomIn" class="grid size-9 place-items-center rounded-xl border border-sand-200 bg-white/95 text-lg text-stone-700 shadow hover:bg-white" aria-label="ซูมเข้า">+</button>
                    <button type="button" id="twinZoomOut" class="grid size-9 place-items-center rounded-xl border border-sand-200 bg-white/95 text-lg text-stone-700 shadow hover:bg-white" aria-label="ซูมออก">−</button>
                    <button type="button" id="twinHome" class="grid size-9 place-items-center rounded-xl border border-sand-200 bg-white/95 text-stone-700 shadow hover:bg-white" aria-label="กลับมุมมองเริ่มต้น">
                        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-8 9 8M5 10v10h5v-6h4v6h5V10" /></svg>
                    </button>
                </div>
                <div id="twinFallback" class="absolute inset-0 hidden place-items-center p-6 text-center text-sm text-stone-500">เบราว์เซอร์นี้ไม่รองรับ WebGL จึงแสดงภาพ 3 มิติไม่ได้ — ดูข้อมูลจากตารางด้านล่างแทน</div>
                <div class="absolute bottom-3 left-3 flex flex-wrap gap-2 text-[11px]">
                    <span class="badge bg-white/90 text-stone-600"><span class="mr-1 inline-block size-2 rounded-full bg-emerald-500"></span>รอไม่นาน</span>
                    <span class="badge bg-white/90 text-stone-600"><span class="mr-1 inline-block size-2 rounded-full bg-amber-500"></span>เริ่มนาน</span>
                    <span class="badge bg-white/90 text-stone-600"><span class="mr-1 inline-block size-2 rounded-full bg-red-500"></span>รอนาน</span>
                    <span class="badge bg-white/90 text-stone-500"><span class="mr-1 inline-block size-2 rounded-full bg-amber-400"></span>เหรียญ = ค่าใช้จ่าย</span>
                    <span class="badge bg-white/90 text-stone-500">คลิกซ้ายลาก = เลื่อน · คลิกขวาลาก = หมุน · scroll = ซูม</span>
                </div>
            </div>
            <aside class="space-y-4 border-t border-sand-200 p-5 lg:border-t-0 lg:border-l">
                <div>
                    <div class="flex items-center justify-between text-sm"><span class="font-medium text-brand-700">OPD รอชำระ</span><span class="text-stone-500" data-field="PendingOCount2">@pendingO.Count ราย</span></div>
                    <div class="text-xl font-semibold tabular-nums" data-field="PendingOAmount">฿@pendingO.Sum(p => p.Amount).ToString("N0")</div>
                    <div class="text-xs text-stone-500">รอเฉลี่ย <span data-field="PendingOWait">@(pendingO.Count == 0 ? 0 : (int)pendingO.Average(p => p.WaitingMinutes))</span> นาที (เป้าหมาย 15 นาที: เขียว &lt; 15, เหลือง &lt; 30)</div>
                </div>
                <div>
                    <div class="flex items-center justify-between text-sm"><span class="font-medium text-stone-800">IPD จำหน่ายแล้ว รอปิดบัญชี</span><span class="text-stone-500" data-field="PendingICount2">@pendingI.Count ราย</span></div>
                    <div class="text-xl font-semibold tabular-nums" data-field="PendingIAmount">฿@pendingI.Sum(p => p.Amount).ToString("N0")</div>
                    <div class="text-xs text-stone-500">รอเฉลี่ย <span data-field="PendingIWait">@(pendingI.Count == 0 ? 0 : (int)pendingI.Average(p => p.WaitingMinutes) / 60)</span> ชม. (เกณฑ์: เขียว &lt; 6, เหลือง &lt; 24 ชม.)</div>
                </div>
                <div id="twinSelection" class="rounded-xl bg-sand-50 p-3 text-xs text-stone-500">คลิกที่ตัวคนเพื่อดูรายละเอียด</div>
            </aside>
        </div>
    </section>

    <!-- ================= รายการผู้ป่วยรอชำระเงิน แยก OPD / IPD (ใต้ 3D) ================= -->
    <section class="grid gap-5 xl:grid-cols-2" aria-label="รายการผู้ป่วยรอชำระเงิน">
        @foreach (var (type, title, location, accent) in new[] { ("O", "OPD — ผู้ป่วยนอกรอชำระเงิน", "คลินิก", "bg-brand-50 text-brand-700"), ("I", "IPD — ผู้ป่วยในรอปิดบัญชี", "หอผู้ป่วย", "bg-stone-800 text-white") })
        {
            <div class="card card-body">
                <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
                    <h2 class="font-semibold text-stone-900"><span class="badge mr-1 @accent">@(type == "O" ? "OPD" : "IPD")</span>@title.Split(" — ")[1]</h2>
                    <span class="text-sm text-stone-500"><b class="tabular-nums text-stone-800" data-field="Pending@(type)Count3">0</b> ราย · <b class="tabular-nums text-stone-800" data-field="Pending@(type)Amount2">฿0</b></span>
                </div>
                <div class="table-wrap max-h-96">
                    <table class="data-table">
                        <thead><tr><th>อ้างอิง</th>@if (showIdentity) { <th>HN</th><th>ชื่อ-สกุล</th> }<th class="text-right">ยอดเงิน</th><th class="text-right">รอมาแล้ว</th><th>กลุ่มผู้จ่าย</th><th>@location</th><th>สถานะ</th></tr></thead>
                        <tbody id="pendingBody@(type)" data-pending-body></tbody>
                    </table>
                </div>
            </div>
        }
        <p class="text-xs text-stone-500 xl:col-span-2">เรียงตามยอดเงินจากมากไปน้อย · @(showIdentity ? "แสดง HN/ชื่อ-สกุลเฉพาะผู้ดูแลระบบ (บันทึกการเข้าถึงทุกครั้ง)" : "ไม่แสดง HN/ชื่อผู้ป่วย") · ยอดเงิน = ค่าใช้จ่ายรวมของ visit · คลิกตัวคนใน 3D เพื่อไฮไลต์แถว</p>
    </section>

    <!-- ================= Charts ================= -->
    <section class="grid gap-5 xl:grid-cols-3">
        <div class="card card-body xl:col-span-2">
            <h2 class="mb-3 font-semibold text-stone-900">รายได้รายวัน 30 วันล่าสุด (OPD / IPD)</h2>
            <div class="h-72"><canvas id="dailyChart" aria-label="กราฟรายได้รายวัน"></canvas></div>
        </div>
        <div class="card card-body">
            <h2 class="mb-3 font-semibold text-stone-900">รายได้เดือนนี้ตามสิทธิการรักษา</h2>
            <div class="h-72"><canvas id="payerChart" aria-label="กราฟรายได้ตามสิทธิ"></canvas></div>
        </div>
    </section>

    <section class="grid gap-5 xl:grid-cols-3">
        <div class="card card-body">
            <div class="mb-3 flex items-baseline justify-between gap-2">
                <h2 class="font-semibold text-stone-900">เงินรับวันนี้ตามวิธีชำระ</h2>
                <b class="tabular-nums text-brand-600" data-field="CollectionsTotal">฿@Model.CollectionsToday.Sum(c => c.NetCollected).ToString("N0")</b>
            </div>
            <div class="h-60"><canvas id="collectionChart" aria-label="กราฟเงินรับวันนี้ตามวิธีชำระ"></canvas></div>
            <p class="mt-2 text-xs text-stone-500">สุทธิหลังหักคืนเงิน · ตามวันที่ชำระ (PatientPaymentDetail)</p>
        </div>
        <div class="card card-body">
            <h2 class="mb-3 font-semibold text-stone-900">รายได้เดือนนี้: เงินสด / เครดิต</h2>
            <dl class="space-y-4 text-sm">
                <div class="flex items-baseline justify-between"><dt class="text-stone-500">บิลเงินสด OPD / IPD</dt><dd class="text-right tabular-nums"><b data-field="CashBilledMonth.Opd">฿@Model.CashBilledMonth.Opd.ToString("N0")</b> / <b data-field="CashBilledMonth.Ipd">฿@Model.CashBilledMonth.Ipd.ToString("N0")</b></dd></div>
                <div class="flex items-baseline justify-between"><dt class="text-stone-500">บิลเครดิต (ลูกหนี้สิทธิ) OPD / IPD</dt><dd class="text-right tabular-nums"><b data-field="CreditBilledMonth.Opd">฿@Model.CreditBilledMonth.Opd.ToString("N0")</b> / <b data-field="CreditBilledMonth.Ipd">฿@Model.CreditBilledMonth.Ipd.ToString("N0")</b></dd></div>
                <div class="flex items-baseline justify-between"><dt class="text-stone-500">สัดส่วนเครดิต</dt><dd class="text-right"><b class="tabular-nums" data-field="CreditShare">@((Model.RevenueMonth.Total == 0 ? 0 : Model.CreditBilledMonth.Total / Model.RevenueMonth.Total * 100).ToString("N1"))%</b></dd></div>
            </dl>
            <p class="mt-4 text-xs text-stone-500">ยอดรับชำระจากผู้จ่ายสิทธิ (สปสช./กรมบัญชีกลาง ฯลฯ) อยู่ในระบบบัญชีภายนอก จึงยังแสดงลูกหนี้คงค้าง/อายุลูกหนี้ไม่ได้</p>
        </div>
        <div class="card card-body">
            <h2 class="mb-3 font-semibold text-stone-900">ปริมาณผู้ป่วย</h2>
            <dl class="grid grid-cols-2 gap-4 text-sm">
                <div><dt class="text-stone-500">OPD visit วันนี้</dt><dd class="text-xl font-semibold tabular-nums" data-field="Volume.OpdVisitsToday">@Model.Volume.OpdVisitsToday.ToString("N0")</dd></div>
                <div><dt class="text-stone-500">ผู้ป่วยในขณะนี้</dt><dd class="text-xl font-semibold tabular-nums" data-field="Volume.IpdAdmittedNow">@Model.Volume.IpdAdmittedNow.ToString("N0")</dd></div>
                <div><dt class="text-stone-500">จำหน่าย IPD วันนี้</dt><dd class="text-xl font-semibold tabular-nums" data-field="Volume.IpdDischargesToday">@Model.Volume.IpdDischargesToday.ToString("N0")</dd></div>
                <div><dt class="text-stone-500">ยอดเฉลี่ยต่อบิลเดือนนี้ OPD / IPD</dt><dd class="font-semibold tabular-nums"><span data-field="Volume.AvgBillOpd">฿@Model.Volume.AvgBillOpd.ToString("N0")</span> / <span data-field="Volume.AvgBillIpd">฿@Model.Volume.AvgBillIpd.ToString("N0")</span></dd></div>
            </dl>
        </div>
    </section>

</div>

<script type="application/json" id="dashboardInitial">@Html.Raw(initialJson)</script>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js" asp-append-version="true"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    <script type="module" src="~/js/finance-twin.js" asp-append-version="true"></script>
}
