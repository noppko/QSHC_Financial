@using Financial.Services.Authorization
@using System.Security.Claims
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject Microsoft.Extensions.Options.IOptions<RoleOptions> RoleSettings
@inject Financial.Services.IReferenceValueService ReferenceValues
@{
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "ผู้ใช้งาน";
    var jobPosition = User.FindFirst("JobPosition")?.Value ?? "";
    var loginName = User.FindFirst("LoginName")?.Value ?? "";
    var initial = string.IsNullOrEmpty(fullName) ? "U" : fullName[..1];
    var roles = AppPolicies.Roles(User).ToList();
    var accessLevel = AppPolicies.GetAccessLevel(User, RoleSettings.Value);
    // ชื่อระดับสิทธิ์จาก ReferenceValues (category ACCESS_LEVEL) — อ่านไม่ได้ใช้ชื่อสำรอง
    var accessLevelName = User.Identity?.IsAuthenticated == true
        ? await ReferenceValues.GetNameAsync(ReferenceCategories.ACCESS_LEVEL, accessLevel, AppPolicies.Describe(accessLevel))
        : string.Empty;
    var accessBadge = accessLevel switch
    {
        AccessLevelCodes.ADMIN => "bg-red-50 text-red-700",
        AccessLevelCodes.FINANCE => "bg-brand-50 text-brand-700",
        _ => "bg-sand-100 text-stone-600",
    };
    var profile = new (string Label, string? Value)[]
    {
        ("ชื่อผู้ใช้", loginName),
        ("ตำแหน่ง", jobPosition),
        ("หน่วยงาน", User.FindFirst("Division")?.Value),
        ("เพศ", User.FindFirst("Gender")?.Value),
        ("อีเมล", User.FindFirst(ClaimTypes.Email)?.Value),
    };
    var csrfToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content="@csrfToken" />
    <title>@ViewData["Title"] - QSHC Financial</title>
    <partial name="_Icons" />
    <link rel="preload" href="~/fonts/kanit/kanit-thai-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="min-h-screen">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-lg focus:bg-white focus:px-3 focus:py-2">ข้ามไปยังเนื้อหา</a>

    <!-- ================= Sidebar ================= -->
    <div id="sidebar-backdrop" class="fixed inset-0 z-30 hidden bg-stone-900/40 lg:hidden" data-sidebar-close></div>
    <aside id="sidebar"
           class="fixed inset-y-0 left-0 z-40 flex w-64 -translate-x-full flex-col border-r border-sand-200 bg-white transition-transform duration-200 lg:translate-x-0">
        <div class="flex h-16 items-center gap-3 border-b border-sand-200 px-5">
            <img src="~/images/qshclogo.png" alt="" class="size-9 rounded-lg object-contain" />
            <div class="leading-tight">
                <div class="font-semibold text-stone-900">QSHC Financial</div>
                <div class="text-xs text-stone-500">ระบบการเงิน ศูนย์หัวใจสิริกิติ์ฯ</div>
            </div>
        </div>
        @await Component.InvokeAsync("SidebarMenu")
        <div class="border-t border-sand-200 p-4 text-xs text-stone-400">
            &copy; @DateTime.Now.Year ศูนย์หัวใจสิริกิติ์ฯ
        </div>
    </aside>

    <!-- ================= Main ================= -->
    <div class="flex min-h-screen flex-col lg:pl-64">
        <header class="sticky top-0 z-20 flex h-16 items-center gap-3 border-b border-sand-200 bg-sand-100/90 px-4 backdrop-blur sm:px-6">
            <button type="button" class="btn-ghost -ml-2 p-2 lg:hidden" data-sidebar-open aria-controls="sidebar" aria-label="เปิดเมนู">
                <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
            </button>
            <h1 class="truncate text-lg font-semibold text-stone-900">@ViewData["Title"]</h1>

            <div class="ml-auto flex items-center gap-2">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <details class="relative" data-user-menu>
                        <summary class="flex cursor-pointer list-none items-center gap-3 rounded-xl px-2 py-1.5 hover:bg-white [&::-webkit-details-marker]:hidden">
                            <span class="grid size-9 place-items-center rounded-full bg-brand-500 font-semibold text-white">@initial</span>
                            <span class="hidden text-left leading-tight sm:block">
                                <span class="block max-w-48 truncate text-sm font-medium text-stone-900">@fullName</span>
                                <span class="block max-w-48 truncate text-xs text-stone-500">@jobPosition</span>
                            </span>
                            <svg class="size-4 text-stone-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg>
                        </summary>
                        <div class="absolute right-0 mt-2 w-80 max-w-[calc(100vw-2rem)] overflow-hidden rounded-2xl border border-sand-200 bg-white shadow-lg">
                            <div class="border-b border-sand-100 px-4 py-3">
                                <div class="truncate font-medium text-stone-900">@fullName</div>
                                <span class="badge mt-1 @accessBadge" data-access-level="@accessLevel">@accessLevelName</span>
                            </div>
                            <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 border-b border-sand-100 px-4 py-3 text-xs">
                                @foreach (var (label, value) in profile.Where(p => !string.IsNullOrWhiteSpace(p.Value) && p.Value != "-"))
                                {
                                    <dt class="text-stone-500">@label</dt>
                                    <dd class="truncate text-stone-800" title="@value">@value</dd>
                                }
                            </dl>
                            <div class="border-b border-sand-100 px-4 py-3">
                                <div class="mb-1.5 text-xs text-stone-500">Role จากระบบยืนยันตัวตน</div>
                                @if (roles.Count == 0)
                                {
                                    <span class="text-xs text-stone-400">ไม่มี role</span>
                                }
                                else
                                {
                                    <ul class="flex flex-wrap gap-1.5" aria-label="Role">
                                        @foreach (var role in roles)
                                        {
                                            <li class="badge bg-stone-100 font-mono text-stone-700" data-role>@role</li>
                                        }
                                    </ul>
                                }
                            </div>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="p-2">
                                <button type="submit" class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-sm text-red-600 hover:bg-red-50">
                                    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 21H6a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3h3M16 17l5-5-5-5M21 12H9" /></svg>
                                    ออกจากระบบ
                                </button>
                            </form>
                        </div>
                    </details>
                }
            </div>
        </header>

        <main id="main" class="flex-1 p-4 sm:p-6">
            @if (TempData["Error"] is string tempError)
            {
                <div class="alert-error mb-4" role="alert">@tempError</div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
