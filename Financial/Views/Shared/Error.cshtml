@model ErrorViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    ViewData["Title"] = "เกิดข้อผิดพลาด";
}
<div class="mx-auto max-w-lg py-16 text-center">
    <div class="mx-auto mb-5 grid size-16 place-items-center rounded-2xl bg-red-100 text-red-600">
        <svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9" /><path d="M12 8v4m0 4h.01" /></svg>
    </div>
    <h2 class="text-xl font-semibold text-stone-900">ขออภัย เกิดข้อผิดพลาดในระบบ</h2>
    <p class="mt-2 text-sm text-stone-500">กรุณาลองใหม่อีกครั้ง หากยังพบปัญหา โปรดแจ้งฝ่ายเทคโนโลยีสารสนเทศพร้อมรหัสอ้างอิงด้านล่าง</p>
    @if (Model?.ShowRequestId == true)
    {
        <p class="mt-4 text-xs text-stone-500">รหัสอ้างอิง: <code class="rounded bg-sand-200 px-2 py-0.5">@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn-primary mt-6">กลับหน้าหลัก</a>
    @if (Env.IsDevelopment())
    {
        <p class="alert-info mt-8 text-left">โหมด Development: ดูรายละเอียดข้อผิดพลาดใน Logs/log-*.txt</p>
    }
</div>
