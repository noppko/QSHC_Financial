@using Financial.Controllers
@using Financial.Services.Authorization
@model AdminSettingsViewModel
@{
    ViewData["Title"] = "ตั้งค่าระบบ";
    var roles = AppPolicies.Roles(User).ToList();
}
<div class="space-y-5">
    @if (TempData["Message"] is string message)
    {
        <div class="alert-success" role="status">@message</div>
    }

    <!-- ================= สิทธิ์การใช้งาน ================= -->
    <section class="card card-body">
        <h2 class="mb-1 font-semibold text-stone-900">สิทธิ์การใช้งานตาม Role</h2>
        <p class="mb-4 text-sm text-stone-500">Role มาจาก External Auth API (<code>data.roles[]</code>) — แก้ได้ที่ <code>appsettings.json</code> section <code>Authorization</code> แล้ว restart แอป</p>
        <div class="table-wrap max-h-none">
            <table class="data-table">
                <thead><tr><th>ระดับ</th><th>เงื่อนไข Role</th><th>Dashboard</th><th>Discharge / Interface EDC</th><th>ตั้งค่าระบบ</th></tr></thead>
                <tbody>
                    <tr>
                        <td><span class="badge bg-red-50 text-red-700">ผู้ดูแลระบบ</span></td>
                        <td class="font-mono text-xs">@string.Join(", ", Model.Roles.AdminRoles)</td>
                        <td>✔</td><td>✔</td><td>✔</td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-brand-50 text-brand-700">เจ้าหน้าที่การเงิน</span></td>
                        <td class="font-mono text-xs">ขึ้นต้นด้วย @string.Join(" / ", Model.Roles.FinanceRolePrefixes.Select(p => p + "*"))</td>
                        <td>✔</td><td>✔</td><td>–</td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-sand-100 text-stone-600">ผู้ใช้งานทั่วไป</span></td>
                        <td class="text-xs text-stone-500">Login ได้ แต่ไม่มี role ข้างต้น</td>
                        <td>✔</td><td>–</td><td>–</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <p class="mt-3 text-xs text-stone-500">Role ของคุณ: @(roles.Count == 0 ? "ไม่มี" : string.Join(", ", roles))</p>
    </section>

    <!-- ================= การแสดงกลุ่มเมนู ================= -->
    <section class="card card-body" id="menu-visibility">
        <div class="mb-4 flex flex-wrap items-start justify-between gap-2">
            <div>
                <h2 class="font-semibold text-stone-900">การแสดงกลุ่มเมนู</h2>
                <p class="text-sm text-stone-500">เปิด/ปิดการมองเห็นกลุ่มเมนูด้านซ้ายและหน้าแผนผังระบบ มีผลกับผู้ใช้ทุกคนทันที · ซ่อนจากเมนูเท่านั้น สิทธิ์เข้าหน้ายังเป็นไปตาม Role</p>
            </div>
            @if (Model.Setting.UpdatedAt is DateTime updatedAt)
            {
                <span class="text-xs text-stone-500">แก้ไขล่าสุด @updatedAt.ToString("d MMM yyyy HH:mm", System.Globalization.CultureInfo.GetCultureInfo("th-TH")) น. โดย @Model.Setting.UpdatedBy</span>
            }
        </div>
        <form asp-action="SaveMenuVisibility" method="post">
            <ul class="divide-y divide-sand-100 rounded-xl border border-sand-200">
                @foreach (var group in Model.MenuGroups)
                {
                    <li class="flex items-center gap-4 px-4 py-3">
                        <div class="min-w-0 flex-1">
                            <div class="font-medium text-stone-900">@group.Title</div>
                            <div class="truncate text-xs text-stone-500">@string.Join(" · ", group.Items)</div>
                        </div>
                        @if (!group.CanHide)
                        {
                            <span class="text-xs text-stone-400">แสดงเสมอ</span>
                            <input type="hidden" name="visibleGroups" value="@group.Key" />
                        }
                        <label class="relative inline-flex cursor-pointer items-center @(group.CanHide ? "" : "pointer-events-none opacity-50")">
                            <input type="checkbox" name="visibleGroups" value="@group.Key" class="peer sr-only"
                                   checked="@group.Visible" disabled="@(!group.CanHide)" aria-label="แสดงกลุ่มเมนู @group.Title" />
                            <span class="h-6 w-11 rounded-full bg-sand-300 transition peer-checked:bg-brand-500 peer-focus-visible:ring-4 peer-focus-visible:ring-brand-100"></span>
                            <span class="absolute top-0.5 left-0.5 size-5 rounded-full bg-white shadow transition peer-checked:translate-x-5"></span>
                        </label>
                    </li>
                }
            </ul>
            <div class="mt-4 flex justify-end">
                <button type="submit" class="btn-primary">บันทึกการแสดงเมนู</button>
            </div>
        </form>
    </section>

    <!-- ================= ดึงข้อมูลรายงานสิทธิ์จาก HIS ================= -->
    <section class="card card-body" id="fiscal-summary">
        <h2 class="mb-1 font-semibold text-stone-900">ดึงข้อมูลรายงานสิทธิ์ตามปีงบประมาณ (สปสช. / กรมบัญชีกลาง / ประกันสังคม / อปท.)</h2>
        <p class="mb-4 text-sm text-stone-500">
            ดึงตัวเลขรวมจาก HIS (อ่านอย่างเดียว) แล้วบันทึกลงตาราง <code>FiscalSchemeTotals</code> / <code>FiscalPayorSummaries</code> ในฐาน QSHC_Financial —
            เลือกได้หลายปีงบ ทุกสิทธิ์ในครั้งเดียว ปีละหลายนาที ทำงานเบื้องหลัง ปิดหน้านี้ได้ · ระบบประมวลผลปีงบปัจจุบันอัตโนมัติทุกคืน
        </p>
        @if (Model.NhsoSummaryError is string summaryError)
        {
            <div class="alert-error mb-4">@summaryError</div>
        }
        @{
            var currentFy = Financial.Services.Reports.FiscalYear.Of(Model.Now).BuddhistYear;
            var yearOptions = Enumerable.Range(currentFy - 9, 10).Reverse().ToList();
            var summaryByYear = Model.NhsoSummaries.ToDictionary(s => s.FiscalYear);
            var th = System.Globalization.CultureInfo.GetCultureInfo("th-TH");
        }
        <div class="flex flex-wrap items-end gap-4">
            <div>
                <label for="from" class="label">ตั้งแต่ปีงบ</label>
                <select id="from" class="input w-32">
                    @foreach (var y in yearOptions) { <option value="@y" selected="@(y == currentFy - 2)">@y</option> }
                </select>
            </div>
            <div>
                <label for="to" class="label">ถึงปีงบ</label>
                <select id="to" class="input w-44">
                    @foreach (var y in yearOptions) { <option value="@y" selected="@(y == currentFy)">@y@(y == currentFy ? " (ปัจจุบัน)" : "")</option> }
                </select>
            </div>
            <button type="button" class="btn-primary" id="fiscalRefresh" data-url="@Url.Action("RefreshFiscal")" data-status-url="@Url.Action("RefreshStatus")">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.6-6.4M21 4v5h-5" /></svg>
                ดึงข้อมูลจาก HIS
            </button>
            <span class="text-xs text-stone-500">เลือกได้ไม่เกิน @AdminController.MAX_REFRESH_YEARS ปีงบต่อครั้ง</span>
        </div>

        <!-- ================= Progress การดึงข้อมูล ================= -->
        <div id="fiscalProgress" class="mt-4 hidden rounded-xl border border-sand-200 bg-sand-50 p-4" role="status" aria-live="polite">
            <div class="mb-2 flex flex-wrap items-baseline justify-between gap-2 text-sm">
                <span class="font-medium text-stone-800" id="fiscalProgressTitle">กำลังดึงข้อมูลจาก HIS</span>
                <span class="tabular-nums text-stone-500" id="fiscalProgressCount"></span>
            </div>
            <div class="h-3 overflow-hidden rounded-full bg-sand-200" role="progressbar" aria-label="ความคืบหน้าการดึงข้อมูล" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="fiscalProgressBar">
                <div class="h-full rounded-full bg-brand-500 transition-all duration-500" id="fiscalProgressFill" style="width: 0%"></div>
            </div>
            <ul class="mt-3 flex flex-wrap gap-2 text-xs" id="fiscalProgressYears"></ul>
            <p class="mt-2 hidden text-xs text-stone-500" id="fiscalProgressDone">เสร็จแล้ว — <a href="" class="font-medium text-brand-700 underline" id="fiscalReload">โหลดหน้านี้ใหม่เพื่อดูสรุป</a></p>
        </div>

        <div class="table-wrap mt-5 max-h-none">
            <table class="data-table">
                <thead><tr><th>ปีงบ</th><th class="text-right">แถวสรุป</th><th class="text-right">ยอดรวม (บาท)</th><th>ดึงจาก HIS ล่าสุด</th></tr></thead>
                <tbody>
                    @for (var fy = currentFy; fy >= currentFy - 5; fy--)
                    {
                        summaryByYear.TryGetValue(fy, out var summary);
                        <tr>
                            <td class="font-medium">@fy @(fy == currentFy ? "(ปัจจุบัน)" : "")</td>
                            <td class="num">@(summary?.Rows.ToString("N0") ?? "–")</td>
                            <td class="num">@(summary?.NetAmount.ToString("N2") ?? "–")</td>
                            <td>@(summary is null ? "ยังไม่เคยดึงข้อมูล" : summary.RefreshedAt.ToString("d MMM yyyy HH:mm", th) + " น.")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <!-- ================= ดึงลูกหนี้สิทธิจาก HIS ================= -->
    @{
        var arStart = ViewData["ReceivableStartDate"] as DateTime? ?? Model.Now.Date;
        var arStatus = ViewData["ReceivableSyncStatus"] as Financial.Services.Receivables.ReceivableSyncStatus;
        var arToday = Model.Now.Date;
        var arTh = System.Globalization.CultureInfo.GetCultureInfo("th-TH");
    }
    <section class="card card-body" id="receivables-sync" data-status-url="@Url.Action("ReceivableSyncStatus")" data-sync-url="@Url.Action("RefreshReceivables")"
             data-active="@((arStatus?.IsActive == true) ? "true" : "false")">
        <h2 class="mb-1 font-semibold text-stone-900">ดึงลูกหนี้สิทธิจาก HIS (สปสช. / กรมบัญชีกลาง / ประกันสังคม / อปท.)</h2>
        <p class="mb-4 text-sm text-stone-500">
            อ่านบิลเครดิตจาก HIS (อ่านอย่างเดียว) มาตั้งหนี้ในตาราง <code>ArReceivables</code> ของ QSHC_Financial — ตรวจซ้ำก่อนบันทึก ·
            ตั้งหนี้ตั้งแต่ <strong>@arStart.ToString("d MMM yyyy", arTh)</strong> (ต้นปีงบ) · ดึงอัตโนมัติทุกคืน · ทำงานเบื้องหลัง ปิดหน้านี้ได้<br />
            บิลแก้ไขหลังจำหน่าย (เช่น เภสัชคีย์ยาเพิ่ม) — เลือกช่วงที่ครอบวันออกบิลเดิม ระบบอัปเดตยอด/เพิ่มบิลใหม่ และติดธง "ต้องตรวจ" ถ้าส่งเรียกเก็บไปแล้ว
        </p>
        <div class="flex flex-wrap items-end gap-4">
            <div>
                <label for="arFrom" class="label">วันออกบิล ตั้งแต่</label>
                <input type="date" id="arFrom" class="input w-44" min="@arStart.ToString("yyyy-MM-dd")" max="@arToday.ToString("yyyy-MM-dd")" value="@arStart.ToString("yyyy-MM-dd")" required />
            </div>
            <div>
                <label for="arTo" class="label">ถึง</label>
                <input type="date" id="arTo" class="input w-44" min="@arStart.ToString("yyyy-MM-dd")" max="@arToday.ToString("yyyy-MM-dd")" value="@arToday.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="flex flex-wrap gap-1 pb-1" aria-label="เลือกช่วงเร็ว">
                <button type="button" class="rounded-lg border border-sand-300 px-2 py-1 text-xs text-stone-600 hover:bg-sand-50" data-ar-range="@arStart.ToString("yyyy-MM-dd")">ต้นปีงบ–วันนี้</button>
                @foreach (var d in new[] { 7, 30, 90 }.Where(d => arToday.AddDays(-d) > arStart))
                {
                    <button type="button" class="rounded-lg border border-sand-300 px-2 py-1 text-xs text-stone-600 hover:bg-sand-50" data-ar-range="@arToday.AddDays(-d).ToString("yyyy-MM-dd")">@d วันล่าสุด</button>
                }
            </div>
            <button type="button" class="btn-primary" id="arSyncButton">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.6-6.4M21 4v5h-5" /></svg>
                ดึงลูกหนี้จาก HIS
            </button>
        </div>
        <div id="arSyncStatus" class="mt-3 text-sm text-stone-600" aria-live="polite">
            @if (arStatus is not null)
            {
                <span>@arStatus.State · @arStatus.Message</span>
            }
        </div>
    </section>

    <!-- ================= แจ้งเตือน Telegram ================= -->
    <section class="card card-body" id="telegram">
        <h2 class="mb-1 font-semibold text-stone-900">แจ้งเตือนผ่าน Telegram</h2>
        <p class="mb-3 text-sm text-stone-500">
            แจ้งเมื่อ Worker ดึงข้อมูลรายงานสิทธิ์จาก HIS สำเร็จ/ไม่สำเร็จ และเมื่อ Dashboard ดึงข้อมูลจาก HIS ไม่ได้ (ซ้ำไม่ถี่กว่า 30 นาที) —
            ข้อความไม่มี HN ชื่อผู้ป่วย หรือ connection string
        </p>
        @{
            var tgConfigured = (bool)(ViewData["TelegramConfigured"] ?? false);
            var tgEnabled = (bool)(ViewData["TelegramEnabled"] ?? false);
        }
        <div class="flex flex-wrap items-center gap-3 text-sm">
            @if (tgConfigured)
            {
                <span class="badge bg-emerald-50 text-emerald-700">ตั้งค่าแล้ว</span>
                <span class="text-stone-600">แชท <span class="font-mono">@ViewData["TelegramChat"]</span>@((bool)(ViewData["TelegramProxy"] ?? false) ? " · ผ่าน proxy" : "")</span>
                <form asp-action="TestTelegram" method="post" class="ml-auto">
                    <button type="submit" class="btn-outline">ส่งข้อความทดสอบ</button>
                </form>
            }
            else
            {
                <span class="badge bg-amber-50 text-amber-700">@(tgEnabled ? "ยังไม่ครบ (ขาด BotToken/ChatId)" : "ปิดอยู่")</span>
                <span class="text-stone-500">ตั้งค่าด้วย User Secrets: <code>dotnet user-secrets set "Telegram:BotToken" "…"</code>, <code>"Telegram:ChatId" "…"</code>, <code>"Telegram:Enabled" "true"</code> (หรือ env var <code>Telegram__BotToken</code> ฯลฯ) แล้ว restart แอป</span>
            }
        </div>
        <p class="mt-3 text-xs text-stone-500">เซิร์ฟเวอร์ต้องออกอินเทอร์เน็ตไปที่ api.telegram.org ได้ (ถ้าต้องผ่าน proxy ตั้ง <code>Telegram:Proxy</code>) · ห้ามใส่ BotToken ใน appsettings.json เพราะไฟล์นี้อยู่ใน git</p>
    </section>

    <div class="grid gap-5 xl:grid-cols-2">
        <!-- ================= Auth API ================= -->
        <section class="card card-body space-y-3">
            <h2 class="font-semibold text-stone-900">ระบบยืนยันตัวตน (External Auth API)</h2>
            <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
                <dt class="text-stone-500">Endpoint</dt><dd class="font-mono text-xs break-all">POST @Model.Auth.AuthEndpoint</dd>
                <dt class="text-stone-500">Timeout</dt><dd>@Model.Auth.TimeoutSeconds วินาที (retry 1 ครั้ง)</dd>
                <dt class="text-stone-500">Session</dt><dd>8 ชั่วโมง (ต่ออายุเมื่อใช้งาน) · จำกัด Login 10 ครั้ง/นาที/IP</dd>
            </dl>
            <button type="button" class="btn-outline" data-test="@Url.Action("TestAuthApi")" data-target="authStatus">ทดสอบการเชื่อมต่อ</button>
            <div id="authStatus" aria-live="polite"></div>
        </section>

        <!-- ================= การตั้งค่าอื่น ================= -->
        <section class="card card-body space-y-3">
            <h2 class="font-semibold text-stone-900">การตั้งค่าอื่น</h2>
            <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
                <dt class="text-stone-500">แหล่งข้อมูล Dashboard</dt><dd>@Model.DashboardSource @(Model.DashboardSource.Equals("Sample", StringComparison.OrdinalIgnoreCase) ? "(ข้อมูลตัวอย่าง)" : "(HIS HealthObject)")</dd>
                <dt class="text-stone-500">โฟลเดอร์อัปโหลด</dt><dd class="font-mono text-xs break-all">@Model.Upload.DefaultDestinationPath</dd>
                <dt class="text-stone-500">ขนาดไฟล์สูงสุด</dt><dd>@(Model.Upload.MaxFileSizeInBytes / 1024 / 1024) MB · @string.Join(", ", Model.Upload.AllowedExtensions)</dd>
            </dl>
            <form asp-action="ClearCache" method="post">
                <button type="submit" class="btn-outline">ล้าง cache ข้อมูล (Dashboard / Discharge)</button>
            </form>
        </section>
    </div>

    <!-- ================= ฐานข้อมูล ================= -->
    <section class="card card-body">
        <h2 class="mb-1 font-semibold text-stone-900">ฐานข้อมูล</h2>
        <p class="mb-4 text-sm text-stone-500">ปุ่มทดสอบจะเปิด connection อย่างเดียว ไม่รันคำสั่ง SQL · ไม่แสดงรหัสผ่าน</p>
        <div class="table-wrap max-h-none">
            <table class="data-table">
                <thead><tr><th>ชื่อ</th><th>Server</th><th>Database</th><th>User</th><th></th></tr></thead>
                <tbody>
                    @foreach (var db in Model.Databases)
                    {
                        <tr>
                            <td class="font-medium">@db.Name</td>
                            <td class="font-mono text-xs">@db.Server</td>
                            <td class="font-mono text-xs">@db.Database</td>
                            <td>
                                @db.User
                                @if (db.UsesSaAccount)
                                {
                                    <span class="badge ml-1 bg-amber-50 text-amber-700" title="ควรใช้ user ที่มีสิทธิ์อ่านอย่างเดียว">ใช้บัญชี sa</span>
                                }
                            </td>
                            <td class="text-right">
                                <button type="button" class="btn-ghost px-3 py-1.5" data-test="@Url.Action("TestDatabase", new { name = db.Name })" data-target="db-@db.Name">ทดสอบ</button>
                                <div id="db-@db.Name" class="mt-1 text-left whitespace-normal" aria-live="polite"></div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/fiscal-refresh.js" asp-append-version="true"></script>
    <script src="~/js/receivables-sync.js" asp-append-version="true"></script>
    <script>
        document.querySelectorAll("[data-test]").forEach(btn => btn.addEventListener("click", async () => {
            const target = document.getElementById(btn.dataset.target);
            const label = btn.textContent;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner"></span>';
            try {
                const r = await app.json(btn.dataset.test, { method: "POST" });
                target.innerHTML = `<div class="${r.success ? "alert-success" : "alert-error"} py-2 text-xs">${app.escapeHtml(r.message)}</div>`;
            } catch (err) {
                target.innerHTML = `<div class="alert-error py-2 text-xs">${app.escapeHtml(err.message)}</div>`;
            } finally {
                btn.disabled = false;
                btn.textContent = label;
            }
        }));
    </script>
}
