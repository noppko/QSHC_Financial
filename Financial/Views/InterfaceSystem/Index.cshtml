@{
    ViewData["Title"] = "นำเข้าไฟล์ EDC";
    var destination = ViewData["DestinationPath"] as string;
}
<div class="grid gap-5 xl:grid-cols-[1fr_320px]">
    <section class="card card-body space-y-6">
        <div>
            <div class="label">โฟลเดอร์ปลายทาง (ตั้งค่าที่ server)</div>
            <div class="flex flex-col gap-2 sm:flex-row">
                <code class="input flex-1 truncate bg-sand-50 font-mono text-xs leading-6">@(string.IsNullOrEmpty(destination) ? "ยังไม่ได้ตั้งค่า FileUpload:DefaultDestinationPath" : destination)</code>
                <button type="button" id="testConnection" class="btn-outline">ทดสอบการเชื่อมต่อ</button>
            </div>
            <div id="connectionStatus" class="mt-3" aria-live="polite"></div>
        </div>

        <form id="uploadForm" class="space-y-4">
            <label for="fileInput" id="dropZone"
                   class="flex cursor-pointer flex-col items-center justify-center rounded-2xl border-2 border-dashed border-sand-300 bg-sand-50 px-6 py-12 text-center transition hover:border-brand-400 hover:bg-brand-50/40">
                <svg class="mb-3 size-10 text-brand-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M12 16V4m0 0-4 4m4-4 4 4M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3" /></svg>
                <span class="font-medium text-stone-800">คลิกเพื่อเลือกไฟล์ หรือลากไฟล์มาวาง</span>
                <span class="mt-1 text-sm text-stone-500">ไฟล์ .txt ขึ้นต้นด้วย HCG14584 · สูงสุด @ViewData["MaxFileSizeMb"] MB</span>
                <input type="file" id="fileInput" name="file" accept=".txt" class="sr-only" />
            </label>

            <dl id="fileInfo" class="hidden grid-cols-[auto_1fr] gap-x-6 gap-y-1 rounded-xl bg-sand-50 p-4 text-sm"></dl>

            <div class="flex gap-3">
                <button type="submit" id="uploadBtn" class="btn-primary" disabled>นำเข้าไฟล์</button>
                <button type="reset" id="clearBtn" class="btn-ghost">ล้าง</button>
            </div>
            <div id="uploadStatus" aria-live="polite"></div>
        </form>
    </section>

    <aside class="alert-info h-fit flex-col">
        <strong class="font-semibold">เงื่อนไขไฟล์</strong>
        <ul class="list-disc space-y-1 pl-5">
            <li>นามสกุล .txt เท่านั้น</li>
            <li>ชื่อไฟล์ต้องขึ้นต้นด้วย <code>HCG14584</code></li>
            <li>ขนาดไม่เกิน @ViewData["MaxFileSizeMb"] MB</li>
            <li>ดูข้อมูลที่นำเข้าแล้วได้ที่เมนู EDC › ข้อมูล</li>
        </ul>
        <a asp-action="DownloadTemplate" class="btn-outline mt-3" download>ดาวน์โหลดไฟล์ template</a>
        <p class="mt-2 text-xs text-stone-500">ไฟล์ตัวอย่าง 1 บรรทัด ข้อมูลสมมติ คั่นด้วย | ลำดับช่องตามตาราง PatientEDCRegister — ไม่มีบรรทัดหัวตาราง (ทุกบรรทัดถูกนำเข้าเป็นข้อมูล) · ตรวจรูปแบบจริงกับไฟล์จากธนาคารก่อนใช้งาน</p>
    </aside>
</div>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById("uploadForm");
            const fileInput = document.getElementById("fileInput");
            const dropZone = document.getElementById("dropZone");
            const fileInfo = document.getElementById("fileInfo");
            const uploadBtn = document.getElementById("uploadBtn");
            const uploadStatus = document.getElementById("uploadStatus");
            const testBtn = document.getElementById("testConnection");
            const connectionStatus = document.getElementById("connectionStatus");
            const { escapeHtml } = window.app;

            const status = (el, ok, message) =>
                el.innerHTML = `<div class="${ok ? "alert-success" : "alert-error"}">${escapeHtml(message)}</div>`;

            function showFile() {
                const file = fileInput.files[0];
                uploadBtn.disabled = !file;
                uploadStatus.innerHTML = "";
                if (!file) { fileInfo.classList.add("hidden"); fileInfo.classList.remove("grid"); return; }
                fileInfo.innerHTML = `
                    <dt class="text-stone-500">ชื่อไฟล์</dt><dd class="truncate font-medium">${escapeHtml(file.name)}</dd>
                    <dt class="text-stone-500">ขนาด</dt><dd>${(file.size / 1024 / 1024).toFixed(2)} MB</dd>`;
                fileInfo.classList.remove("hidden"); fileInfo.classList.add("grid");
            }

            fileInput.addEventListener("change", showFile);
            ["dragenter", "dragover"].forEach(ev => dropZone.addEventListener(ev, e => { e.preventDefault(); dropZone.classList.add("border-brand-500"); }));
            ["dragleave", "drop"].forEach(ev => dropZone.addEventListener(ev, () => dropZone.classList.remove("border-brand-500")));
            dropZone.addEventListener("drop", e => { e.preventDefault(); fileInput.files = e.dataTransfer.files; showFile(); });
            form.addEventListener("reset", () => setTimeout(showFile));

            testBtn.addEventListener("click", async () => {
                testBtn.disabled = true;
                testBtn.innerHTML = '<span class="spinner"></span> กำลังทดสอบ...';
                try {
                    const r = await app.json("@Url.Action("TestConnection")", { method: "POST" });
                    status(connectionStatus, r.success, r.message);
                } catch (err) {
                    status(connectionStatus, false, err.message);
                } finally {
                    testBtn.disabled = false;
                    testBtn.textContent = "ทดสอบการเชื่อมต่อ";
                }
            });

            form.addEventListener("submit", async e => {
                e.preventDefault();
                const file = fileInput.files[0];
                if (!file) return;
                const data = new FormData();
                data.append("file", file);
                uploadBtn.disabled = true;
                uploadBtn.innerHTML = '<span class="spinner"></span> กำลังนำเข้า...';
                try {
                    const r = await app.json("@Url.Action("ImportEDC")", { method: "POST", body: data });
                    if (r.success) { status(uploadStatus, true, `นำเข้าสำเร็จ ${r.records.toLocaleString("th-TH")} รายการ`); form.reset(); }
                    else status(uploadStatus, false, r.error);
                } catch (err) {
                    status(uploadStatus, false, err.message);
                } finally {
                    uploadBtn.textContent = "นำเข้าไฟล์";
                    uploadBtn.disabled = !fileInput.files[0];
                }
            });
        })();
    </script>
}
