@model IEnumerable<Financial.Database.InterfaceSystem.Models.PatientEdcregister>
@{
    ViewData["Title"] = "ข้อมูล EDC";
}
<div class="space-y-5">
    <section class="card card-body">
        <h2 class="mb-1 font-semibold text-stone-900">ตรวจไฟล์ก่อนนำเข้า</h2>
        <p class="mb-4 text-sm text-stone-500">อ่านไฟล์ (คั่นด้วย |) เพื่อแสดงตัวอย่างเท่านั้น ยังไม่บันทึกลงฐานข้อมูล — นำเข้าจริงที่เมนู “นำเข้าไฟล์ EDC”</p>
        <form id="previewForm" class="flex flex-col gap-3 sm:flex-row">
            <input type="file" name="file" accept=".txt" required class="input file:mr-3 file:rounded-lg file:border-0 file:bg-brand-50 file:px-3 file:py-1 file:text-brand-700" />
            <button type="submit" class="btn-primary">แสดงตัวอย่าง</button>
        </form>
        <div id="previewResult" class="mt-4" aria-live="polite"></div>
    </section>

    <section class="card card-body">
        <h2 class="mb-4 font-semibold text-stone-900">รายการลงทะเบียน EDC ล่าสุด (50 รายการ)</h2>
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(m => m.Code)</th>
                        <th>@Html.DisplayNameFor(m => m.TransactionDate)</th>
                        <th>@Html.DisplayNameFor(m => m.PostDate)</th>
                        <th>@Html.DisplayNameFor(m => m.MerchantName)</th>
                        <th>@Html.DisplayNameFor(m => m.TerminalId)</th>
                        <th>@Html.DisplayNameFor(m => m.Name)</th>
                        <th>@Html.DisplayNameFor(m => m.Surname)</th>
                        <th>@Html.DisplayNameFor(m => m.Paidtype1)</th>
                        <th class="text-right">@Html.DisplayNameFor(m => m.TranAmt)</th>
                        <th>@Html.DisplayNameFor(m => m.Batch)</th>
                        <th>@Html.DisplayNameFor(m => m.Trace)</th>
                        <th>@Html.DisplayNameFor(m => m.AppCode)</th>
                        <th>@Html.DisplayNameFor(m => m.TransRefId)</th>
                        <th>@Html.DisplayNameFor(m => m.StatusFlag)</th>
                        <th>@Html.DisplayNameFor(m => m.Cwhen)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="15" class="py-14 text-center text-stone-500">ยังไม่มีข้อมูล</td></tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Code</td>
                            <td>@Html.DisplayFor(_ => item.TransactionDate)</td>
                            <td>@Html.DisplayFor(_ => item.PostDate)</td>
                            <td>@item.MerchantName</td>
                            <td>@item.TerminalId</td>
                            <td>@item.Name</td>
                            <td>@item.Surname</td>
                            <td>@item.Paidtype1</td>
                            <td class="num">@Html.DisplayFor(_ => item.TranAmt)</td>
                            <td>@item.Batch</td>
                            <td>@item.Trace</td>
                            <td>@item.AppCode</td>
                            <td>@item.TransRefId</td>
                            <td><span class="badge @(item.StatusFlag == "A" ? "bg-emerald-50 text-emerald-700" : "bg-sand-100 text-stone-600")">@item.StatusFlag</span></td>
                            <td>@Html.DisplayFor(_ => item.Cwhen)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById("previewForm");
            const result = document.getElementById("previewResult");
            const { escapeHtml } = window.app;

            form.addEventListener("submit", async e => {
                e.preventDefault();
                const btn = form.querySelector("button");
                btn.disabled = true;
                result.innerHTML = '<div class="flex items-center gap-2 text-sm text-stone-500"><span class="spinner"></span> กำลังอ่านไฟล์...</div>';
                try {
                    const r = await app.json("@Url.Action("PreviewEDCFile")", { method: "POST", body: new FormData(form) });
                    const cols = Math.max(0, ...r.data.map(row => row.length));
                    const head = Array.from({ length: cols }, (_, i) => `<th>คอลัมน์ ${i + 1}</th>`).join("");
                    const body = r.data.map(row => `<tr>${Array.from({ length: cols }, (_, i) => `<td>${escapeHtml(row[i])}</td>`).join("")}</tr>`).join("");
                    result.innerHTML = `
                        <p class="mb-2 text-sm text-stone-600">พบ ${r.total.toLocaleString("th-TH")} รายการ${r.total > r.data.length ? ` (แสดง ${r.data.length} รายการแรก)` : ""}</p>
                        <div class="table-wrap max-h-96"><table class="data-table"><thead><tr>${head}</tr></thead><tbody>${body}</tbody></table></div>`;
                } catch (err) {
                    result.innerHTML = `<div class="alert-error">${escapeHtml(err.message)}</div>`;
                } finally {
                    btn.disabled = false;
                }
            });
        })();
    </script>
}
